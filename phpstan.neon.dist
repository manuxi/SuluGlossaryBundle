parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        - tests/App/var (?)
    tmpDir: var/cache/phpstan
    ignoreErrors:
        -
            message: '#is never assigned int so it can be removed from the property type#'
            identifier: property.unusedType
            path: src/Entity
        -
            message: '#generic class Symfony\\Component\\Workflow\\Event\\CompletedEvent (but )?does not specify its types#'
            identifier: missingType.generics
            reportUnmatched: false
