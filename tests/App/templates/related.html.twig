{% extends "base.html.twig" %}

{% block content %}
<h1>{{ content.title }}</h1>
<ul id="related">{% for item in content.related|default([]) %}<li>{{ item.title }}</li>{% endfor %}</ul>
<p id="main">{{ content.main.title|default('') }}</p>
<ul id="smart">{% for item in content.smart|default([]) %}<li>{{ item.title }}</li>{% endfor %}</ul>
{% endblock %}
